# Скопируйте в .env и заполните. Файл .env не попадает в git.

# ── Сайт и браузер ───────────────────────────────────────────
BASE_URL=https://mebel169.ru
LK_URL=https://lk.169.ru
# firefox | chromium | webkit. Headless Chromium блокируется CAPTCHA, используйте firefox
# или chromium с HEADLESS=false
BROWSER=firefox
HEADLESS=true
# замедление действий браузера в мс (удобно для показа в видимом браузере)
# SLOW_MO_MS=500
WORKERS=2

# ── Тайм-ауты, мс ────────────────────────────────────────────
ACTION_TIMEOUT_MS=15000
NAVIGATION_TIMEOUT_MS=45000
EXPECT_TIMEOUT_MS=10000
TEST_TIMEOUT_MS=180000

# ── Логи и данные ────────────────────────────────────────────
# debug | info | warn | error
LOG_LEVEL=info
LOG_DIR=logs
TEST_DATA_DIR=autotest/data

# ── Тестовая учётная запись (секреты) ────────────────────────
TEST_USER_PHONE=
TEST_USER_EMAIL=
TEST_USER_PASSWORD=
# Имя, которое показывается в шапке сайта после входа
TEST_USER_NAME=

# ── Данные для оформления (по умолчанию — из учётной записи) ──
CHECKOUT_NAME=
CHECKOUT_PHONE=
CHECKOUT_EMAIL=

# ── Сквозной сценарий ────────────────────────────────────────
# true — нажимать «Подтвердить заказ» (только с разрешения владельца сайта)
ORDER_SUBMIT=false
# true — прогнать сценарий гостем без шага «Вход» (только для отладки)
E2E_ALLOW_GUEST=false
